generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Role {
  ADMIN       // Quản trị viên hệ thống
  HOST        // Chủ hộ / Trưởng gia đình (Quản lý toàn bộ thu chi, ngân sách, mời thành viên)
  MEMBER      // Thành viên gia đình (Tạo giao dịch, xem báo cáo, đóng góp tiết kiệm)
  VIEWER      // Người xem (Ví dụ: Con nhỏ, chỉ xem danh sách/báo cáo, không sửa xóa được)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // <--- Đổi thành optional (?)
  googleId  String?  @unique // <--- Thêm field googleId
  fullName  String
  avatar    String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyId     String?
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  goalLogs     GoalLog[]

  @@map("users")
}

model Family {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members      User[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]

  @@map("families")
}

model Category {
  id        String          @id @default(uuid())
  name      String
  type      TransactionType @default(EXPENSE)
  icon      String?         // Tên Lucide icon hoặc Emoji (vd: "ShoppingBag", " Utensils")
  imageUrl  String?         // URL ảnh được upload lên Cloudinary
  createdAt DateTime        @default(now())

  familyId     String?
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float           // Số tiền giao dịch
  type        TransactionType // INCOME (Thu) hoặc EXPENSE (Chi)
  note        String?         // Ghi chú giao dịch
  date        DateTime        @default(now()) // Ngày thực hiện giao dịch
  imageUrl    String?         // Ảnh hóa đơn / chứng từ (nếu có)

  // Khóa ngoại
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  familyId    String
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)

  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([familyId])
  @@index([categoryId])
  @@index([date])
}

model Budget {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now())

  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([familyId, categoryId, month, year])
  @@map("budgets")
}

model Goal {
  id            String      @id @default(uuid())
  title         String
  emoji         String      @default("🎯")
  targetAmount  Decimal     @db.Decimal(12, 2)
  currentAmount Decimal     @default(0) @db.Decimal(12, 2)
  barColor      String      @default("from-purple-600 to-indigo-400")
  deadline      DateTime?
  familyId      String
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  logs          GoalLog[]   // Lịch sử nạp/rút
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model GoalLog {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(12, 2)
  type      String   // "DEPOSIT" (Nạp) hoặc "WITHDRAW" (Rút)
  note      String?
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
